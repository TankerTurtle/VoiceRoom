* { box-sizing:border-box; }
html,body { margin:0; background:transparent; color:#fff; font:14px/1.3 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
body { padding:6px; --alpha:.55; }
#bar { display:inline-flex; align-items:center; gap:6px; padding:4px 8px; background:rgba(0,0,0,var(--alpha)); border-radius:10px; }
#title { font-weight:600; font-size:13px; }
#bar button { width:30px; height:30px; padding:0; color:#fff; font-size:16px; background:rgba(255,255,255,.12); border:0; border-radius:8px; cursor:pointer; touch-action:manipulation; }
.dot { width:9px; height:9px; border-radius:50%; background:#888; }
.dot.on { background:#3ddc84; } .dot.off { background:#d9453a; }
#list { margin-top:6px; display:flex; flex-direction:column; gap:4px; align-items:flex-start; }
.m { display:flex; align-items:center; gap:7px; padding:3px 10px 3px 4px; background:rgba(0,0,0,var(--alpha)); border-radius:18px; transition:opacity .2s; }
.m img { width:26px; height:26px; border-radius:50%; border:2px solid transparent; transition:border-color .12s, box-shadow .12s; }
.m.talk img { border-color:#3ddc84; box-shadow:0 0 8px 2px rgba(61,220,132,.8); }
.m .n { max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.m .s { font-size:12px; opacity:.9; }
.m:not(.talk) { opacity:.78; }
body.mini #list .m:not(.talk) { display:none; }
body.mini #bar #title { display:none; }
body.hidelist #list { display:none; }
#hint { display:none; margin:8px 0 0; padding:6px 8px; background:rgba(0,0,0,.6); border-radius:8px; font-size:12px; }
body.nokey #hint { display:block; }
